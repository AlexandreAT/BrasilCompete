{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "None"
    }
  },
  "Worker": {
    "UserAgent": "BrasilCompete-Viability/0.1 (+https://github.com/AlexandreAT/BrasilCompete)",
    "SourcePriority": [
      "manual",
      "jolpica",
      "lichess",
      "liquipedia",
      "fivb",
      "balldontlie",
      "football-data",
      "wikipedia",
      "thesportsdb",
      "pandascore"
    ]
  },
  "Sources": {
    "Manual": {
      "Enabled": true,
      "FilePath": "curation/manual-events.json"
    },
    "Wikidata": {
      "Enabled": true,
      "DetailsBatchSize": 200,
      "Http": {
        "BaseUrl": "https://query.wikidata.org/",
        "MinIntervalMilliseconds": 2000,
        "CacheTtlHours": 168,
        "RetryAfter429Seconds": 60
      }
    }
  }
}
